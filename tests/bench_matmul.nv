// bench_matmul.nv — the one number the next release is measured
// against.
//
// Performance is not this release's deliverable; correctness and the
// published semantics are.  This file exists so that the release
// AFTER it has something to compare to, because a package with no
// baseline cannot tell an optimisation from a regression.
//
// 64-by-64 is the size chosen: big enough that the 262,144
// multiply-adds dominate the two buffer reads and the result's
// allocation, small enough to run in a second on the interpreter too.
//
// It is a PROGRAM and not a `@test`.  A wall-clock assertion is a
// test that fails on a loaded build machine and tells nobody
// anything, so this prints a number and the reader decides.  `novo
// test` never runs it — the file is not named `*_tests.nv` — and
// `matmul` itself is asserted in three suites that are.
//
//     novo run tests/bench_matmul.nv
//     novo run tests/bench_matmul.nv --interp
//
// `bench.black_box_float` is what keeps the answer alive: without it
// LLVM can see that nothing reads the products and delete the loop,
// and the benchmark then measures an empty loop very accurately.

use std.time
use std.bench
use ndshape
use ndfault
use ndfloat
use ndint
use ndbool

// What an operation could not do, said in one line.  `ndfault` is the
// package's one error type and every module answers with it.
fn say(e: ndfault.NdFault) -> Str
    e.message()

// An `n`-by-`n` matrix of Float whose elements are a hash of their
// position, so both operands are dense, neither is a special case,
// and the run is the same run every time.
fn dense(n: Int, salt: Int) -> NdFloat
    let cells = list.map(0..n * n,
        i => int.to_float((i * 7919 + salt * 104729 + 12345) % 1000 - 500) / 100.0)
    match ndfloat.of_list(cells, [n, n])
        Ok(a)  => a
        Err(_) => ndfloat.scalar(0.0)

// The same matrix as integers, for the other array's baseline.
fn dense_int(n: Int, salt: Int) -> NdInt
    let cells = list.map(0..n * n,
        i => (i * 7919 + salt * 104729 + 12345) % 1000 - 500)
    match ndint.of_list(cells, [n, n])
        Ok(a)  => a
        Err(_) => ndint.scalar(0)

fn main() [io, time]
    let n = 64
    let reps = 20
    let a = dense(n, 1)
    let b = dense(n, 2)
    println("ndarray-nv matmul baseline — two ${ndshape.size(ndfloat.shape(a))}-element operands, shape ${ndfloat.shape(a).dims}")

    // One multiply before the clock starts, so the first run's
    // allocation growth is not counted as the cost of the loop, and
    // so the answer is looked at once before it is only summed.
    var sink = 0.0
    match ndfloat.matmul(a, b)
        Ok(p)  =>
            sink = bench.black_box_float(ndfloat.sum(p))
            match ndfloat.gt(p, ndfloat.scalar(0.0))
                Ok(m)  => println("  ${ndbool.count(m)} of ${ndfloat.size(p)} products are above zero")
                Err(e) => println("  the comparison failed: ${say(e)}")
        Err(e) => println("warm-up failed: ${say(e)}")

    let t0 = time.now()
    for i in 0..reps
        match ndfloat.matmul(a, b)
            Ok(p)  =>
                sink = bench.black_box_float(sink + ndfloat.sum(p))
            Err(e) => println("matmul failed: ${say(e)}")
    let secs = time.elapsed_since(t0)

    let ai = dense_int(n, 1)
    let bi = dense_int(n, 2)
    var isink = 0
    match ndint.matmul(ai, bi)
        Ok(p)  =>
            isink = bench.black_box_int(ndint.sum(p))
        Err(e) => println("warm-up failed: ${say(e)}")

    let t1 = time.now()
    for i in 0..reps
        match ndint.matmul(ai, bi)
            Ok(p)  =>
                isink = bench.black_box_int(isink + ndint.sum(p))
            Err(e) => println("matmul failed: ${say(e)}")
    let isecs = time.elapsed_since(t1)

    let ops = int.to_float(n * n * n)
    let per = secs / int.to_float(reps)
    let iper = isecs / int.to_float(reps)
    println("ndfloat.matmul ${n}x${n}: ${reps} multiplies in ${secs} s")
    println("  per multiply     : ${per * 1000.0} ms")
    println("  per multiply-add : ${per / ops * 1000000000.0} ns")
    println("ndint.matmul ${n}x${n}: ${reps} multiplies in ${isecs} s")
    println("  per multiply     : ${iper * 1000.0} ms")
    println("  per multiply-add : ${iper / ops * 1000000000.0} ns")
    println("sink ${sink} ${isink}")
