// ndint.nv — the N-dimensional array of Int: counts, positions,
// labels and indices.
//
// WHY THIS IS A SEPARATE TYPE AND NOT `NdFloat` WITH A DTYPE TAG.  Two
// reasons, and the first is the one that decided it.  A dtype tag
// makes every function in the package branch on it, which turns one
// `sum` into a `sum` with two bodies and a third case for the
// combination nobody meant; and an Int that has been through a double
// is not the Int that went in above 2^53, which is exactly the range a
// row count reaches in the data a notebook loads.  Positions and
// counts are integers, and they stay integers here.
//
// WHY IT IS NOT ONE GENERIC `NdArray<T>` INSTEAD.  Because a generic
// container cannot be called across a module boundary today.  The
// measurement is in `ndfloat`'s module comment and the argument is in
// the README; the surface below deliberately MIRRORS `ndfloat`'s,
// member for member and name for name, so that the day the compiler
// can carry a type parameter out of a module the two collapse into one
// by deletion.
//
// WHAT IS DELIBERATELY MISSING, AND WHERE IT WENT.  There is no
// `mean`, no `sqrt`, no `exp`, no `ln` and no `linspace` here: every
// one of them answers with a number that is not an integer, and
// rounding it silently is worse than making the caller write
// `to_float` and mean it.  `ndint.to_float` is that call.
//
// EVERYTHING ELSE IS `ndfloat`'S STORY.  Views, broadcasting, the
// absence of an in-place write, the absence of an `add_scalar`: all
// four hold here for the same reasons and are argued there and in
// `ndshape`.

use std.math

// An N-dimensional array of Int over a flat buffer.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2, 3, 4], [2, 2])
//         Ok(a)  => println("${ndint.sum(a)}")
//         Err(e) => println(e.message())
// ```
pub struct NdInt
    // The flat buffer.  Its length is not the array's size: a view
    // addresses a window inside it, and a broadcast axis reads one
    // element many times.
    data: [Int]
    // The extents and the strides — see `ndshape`.
    shape: NdShape
    // The flat position of element `[0, 0, …]`.
    offset: Int

// An array over these integers, in this shape, row-major.
//
// `NdSizeMismatch` when the product of `dims` is not the length of
// `data`, and `NdBadRange` for a negative dimension.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2, 3], [3])
//         Ok(a)  => println("${ndint.to_list(a)}")
//         Err(e) => println(e.message())
// ```
pub fn of_list(data: [Int], dims: [Int]) -> Result<NdInt, NdFault>
    for d in dims
        if d < 0
            return Err(NdBadRange("a shape with a negative dimension"))
    let s = ndshape.of_dims(dims)
    let want = ndshape.size(s)
    if want != list.len(data)
        return Err(NdSizeMismatch(want, list.len(data)))
    Ok(NdInt { data: data, shape: s, offset: 0 })

// The rank-0 array holding one integer, which broadcasts against every
// shape.
//
// ```novo
// use ndint
//
// fn main() [io]
//     println("${ndint.sum(ndint.scalar(3))}")
// ```
pub fn scalar(value: Int) -> NdInt
    NdInt { data: [value], shape: ndshape.scalar(), offset: 0 }

// An array of this shape, every element 0.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.zeros([2, 3])
//         Ok(a)  => println("${ndint.sum(a)}")
//         Err(e) => println(e.message())
// ```
pub fn zeros(dims: [Int]) -> Result<NdInt, NdFault>
    filled(dims, 0)

// An array of this shape, every element 1.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.ones([2, 3])
//         Ok(a)  => println("${ndint.sum(a)}")
//         Err(e) => println(e.message())
// ```
pub fn ones(dims: [Int]) -> Result<NdInt, NdFault>
    filled(dims, 1)

// An array of this shape, every element the same integer.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.filled([2, 2], 7)
//         Ok(a)  => println("${ndint.sum(a)}")
//         Err(e) => println(e.message())
// ```
pub fn filled(dims: [Int], value: Int) -> Result<NdInt, NdFault>
    for d in dims
        if d < 0
            return Err(NdBadRange("a shape with a negative dimension"))
    let s = ndshape.of_dims(dims)
    let out: [Int] = list.map(list.range(0, ndshape.size(s)), i => value)
    Ok(NdInt { data: out, shape: s, offset: 0 })

// The rank-1 array `start, start+step, …`, stopping BEFORE `stop`.
//
// Half-open, and `NdBadRange` for a zero step or one that points away
// from `stop` — the same rule as `ndfloat.arange`, which is where it
// is argued.  This is the one a loop over row numbers wants.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.arange(0, 5, 1)
//         Ok(a)  => println("${ndint.to_list(a)}")
//         Err(e) => println(e.message())
// ```
pub fn arange(start: Int, stop: Int, step: Int) -> Result<NdInt, NdFault>
    if step == 0
        return Err(NdBadRange("an arange whose step is zero"))
    if step > 0 and stop < start
        return Err(NdBadRange("an arange whose step points away from its stop"))
    if step < 0 and stop > start
        return Err(NdBadRange("an arange whose step points away from its stop"))
    // numpy's count, `ceil((stop - start) / step)`, done in integers:
    // both operands of the division below are non-negative, so the
    // truncating `/` is the floor and the `+ width - 1` is the ceiling.
    var span = stop - start
    var width = step
    if step < 0
        span = start - stop
        width = 0 - step
    let n = (span + width - 1) / width
    let out: [Int] = list.map(list.range(0, n), i => start + i * step)
    Ok(NdInt { data: out, shape: ndshape.of_dims([n]), offset: 0 })

// This array's layout.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.zeros([2, 3])
//         Ok(a)  => println("${ndint.shape(a).dims}")
//         Err(e) => println(e.message())
// ```
pub fn shape(a: NdInt) -> NdShape
    a.shape

// How many axes this array has.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.zeros([2, 3])
//         Ok(a)  => println("${ndint.rank(a)}")
//         Err(e) => println(e.message())
// ```
pub fn rank(a: NdInt) -> Int
    list.len(a.shape.dims)

// How many elements this array has.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.zeros([2, 3])
//         Ok(a)  => println("${ndint.size(a)}")
//         Err(e) => println(e.message())
// ```
pub fn size(a: NdInt) -> Int
    ndshape.size(a.shape)

// The integer at one full index.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2, 3, 4], [2, 2])
//         Ok(a)  =>
//             match ndint.at(a, [1, 0])
//                 Ok(v)  => println("${v}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn at(a: NdInt, index: [Int]) -> Result<Int, NdFault>
    match ndshape.flat_index(a.shape, index)
        Err(e) => Err(e)
        Ok(f)  => Ok(a.data[a.offset + f])

// The same array with one element changed — a new array, not a write.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.zeros([2, 2])
//         Ok(a)  =>
//             match ndint.with(a, [0, 1], 5)
//                 Ok(b)  => println("${ndint.sum(b)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn with(a: NdInt, index: [Int], value: Int) -> Result<NdInt, NdFault>
    // The answer is packed, so the position to change is the position in
    // ROW-MAJOR order rather than in this array's own strides.
    let packed = ndshape.of_dims(a.shape.dims)
    match ndshape.flat_index(packed, index)
        Err(e) => Err(e)
        Ok(at) =>
            var out: [Int] = []
            var i = 0
            for v in ni_read(a)
                if i == at
                    out = list.push(out, value)
                else
                    out = list.push(out, v)
                i = i + 1
            Ok(NdInt { data: out, shape: packed, offset: 0 })

// Every element in row-major order, view or not.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2], [2])
//         Ok(a)  => println("${ndint.to_list(a)}")
//         Err(e) => println(e.message())
// ```
pub fn to_list(a: NdInt) -> [Int]
    ni_read(a)

// The same elements under a different shape — a view when the array is
// packed, a copy when it is not.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2, 3, 4], [4])
//         Ok(a)  =>
//             match ndint.reshape(a, [2, 2])
//                 Ok(b)  => println("${ndint.shape(b).dims}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn reshape(a: NdInt, dims: [Int]) -> Result<NdInt, NdFault>
    for d in dims
        if d < 0
            return Err(NdBadRange("a shape with a negative dimension"))
    let s = ndshape.of_dims(dims)
    let want = ndshape.size(s)
    if want != ndshape.size(a.shape)
        return Err(NdSizeMismatch(want, ndshape.size(a.shape)))
    if ndshape.is_packed(a.shape)
        return Ok(NdInt { data: a.data, shape: s, offset: a.offset })
    Ok(NdInt { data: ni_read(a), shape: s, offset: 0 })

// Every axis reversed.  A view; it does not copy.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2, 3, 4, 5, 6], [2, 3])
//         Ok(a)  => println("${ndint.shape(ndint.transpose(a)).dims}")
//         Err(e) => println(e.message())
// ```
pub fn transpose(a: NdInt) -> NdInt
    NdInt { data: a.data, shape: ndshape.reverse_axes(a.shape), offset: a.offset }

// Two axes exchanged.  A view; it does not copy.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.zeros([2, 3, 4])
//         Ok(a)  =>
//             match ndint.swap_axes(a, 0, 2)
//                 Ok(b)  => println("${ndint.shape(b).dims}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn swap_axes(a: NdInt, first: Int, second: Int) -> Result<NdInt, NdFault>
    match ndshape.swap_axes(a.shape, first, second)
        Err(e) => Err(e)
        Ok(s)  => Ok(NdInt { data: a.data, shape: s, offset: a.offset })

// The positions `[start, stop)` along one axis, every other axis
// whole.  A view; rank is unchanged.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.zeros([4, 3])
//         Ok(a)  =>
//             match ndint.slice_axis(a, 0, 1, 3)
//                 Ok(b)  => println("${ndint.shape(b).dims}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn slice_axis(a: NdInt, axis: Int, start: Int, stop: Int) -> Result<NdInt, NdFault>
    let r = list.len(a.shape.dims)
    if axis < 0 or axis >= r
        return Err(NdAxisOutOfRange(axis, r))
    if start < 0 or stop < start or stop > a.shape.dims[axis]
        return Err(NdBadRange("a slice whose bounds are not inside its axis"))
    var dims: [Int] = []
    for i in 0..r
        if i == axis
            dims = list.push(dims, stop - start)
        else
            dims = list.push(dims, a.shape.dims[i])
    Ok(NdInt { data: a.data,
        shape: NdShape { dims: dims, strides: a.shape.strides },
        offset: a.offset + start * a.shape.strides[axis] })

// One position along one axis, with that axis DROPPED.  A view.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.zeros([4, 3])
//         Ok(a)  =>
//             match ndint.index_axis(a, 0, 2)
//                 Ok(r)  => println("${ndint.shape(r).dims}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn index_axis(a: NdInt, axis: Int, at: Int) -> Result<NdInt, NdFault>
    match ndshape.drop_axis(a.shape, axis)
        Err(e) => Err(e)
        Ok(s)  =>
            if at < 0 or at >= a.shape.dims[axis]
                return Err(NdIndexOutOfRange([at], a.shape.dims))
            Ok(NdInt { data: a.data, shape: s, offset: a.offset + at * a.shape.strides[axis] })

// The array stretched to a shape it broadcasts to, by
// `ndshape.broadcast`.  A view.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2, 3], [3])
//         Ok(a)  =>
//             match ndint.broadcast_to(a, [2, 3])
//                 Ok(b)  => println("${ndint.size(b)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn broadcast_to(a: NdInt, dims: [Int]) -> Result<NdInt, NdFault>
    for d in dims
        if d < 0
            return Err(NdBadRange("a shape with a negative dimension"))
    match ni_stretch(a.shape, dims)
        Err(e) => Err(e)
        Ok(s)  => Ok(NdInt { data: a.data, shape: s, offset: a.offset })

// The same array over a fresh, contiguous, exactly-sized buffer.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.zeros([2, 3])
//         Ok(a)  => println("${ndint.size(ndint.pack(a))}")
//         Err(e) => println(e.message())
// ```
pub fn pack(a: NdInt) -> NdInt
    if a.offset == 0 and ndshape.is_packed(a.shape) and list.len(a.data) == ndshape.size(a.shape)
        return a
    NdInt { data: ni_read(a), shape: ndshape.of_dims(a.shape.dims), offset: 0 }

// Element-by-element sum, broadcasting by `ndshape.broadcast`.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2], [2])
//         Ok(a)  =>
//             match ndint.add(a, ndint.scalar(10))
//                 Ok(b)  => println("${ndint.to_list(b)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn add(left: NdInt, right: NdInt) -> Result<NdInt, NdFault>
    ni_zip(left, right, ni_plus)

// Element-by-element difference, broadcasting by `ndshape.broadcast`.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.ones([3])
//         Ok(a)  =>
//             match ndint.sub(a, a)
//                 Ok(b)  => println("${ndint.sum(b)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn sub(left: NdInt, right: NdInt) -> Result<NdInt, NdFault>
    ni_zip(left, right, ni_minus)

// Element-by-element product, broadcasting by `ndshape.broadcast`.
// NOT the matrix product — that is `matmul`.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2, 3], [3])
//         Ok(a)  =>
//             match ndint.mul(a, a)
//                 Ok(b)  => println("${ndint.to_list(b)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn mul(left: NdInt, right: NdInt) -> Result<NdInt, NdFault>
    ni_zip(left, right, ni_times)

// Element-by-element quotient, TRUNCATED towards zero, broadcasting by
// `ndshape.broadcast`.
//
// `NdBadRange` when any divisor is 0, which is the opposite of
// `ndfloat.div`'s call and for the opposite reason: integer division
// has no infinity to return, so there is no value that would let the
// run finish honestly.  Truncation rather than flooring means
// `div(scalar(-7), scalar(2))` is -3, matching the language's own `/`.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([4, 9], [2])
//         Ok(a)  =>
//             match ndint.div(a, ndint.scalar(2))
//                 Ok(b)  => println("${ndint.to_list(b)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn div(left: NdInt, right: NdInt) -> Result<NdInt, NdFault>
    match ni_pair(left, right)
        Err(e) => Err(e)
        Ok(p)  =>
            var out: [Int] = []
            for i in 0..list.len(p.left)
                if p.right[i] == 0
                    return Err(NdBadRange("an integer division by zero"))
                out = list.push(out, p.left[i] / p.right[i])
            Ok(NdInt { data: out, shape: ndshape.of_dims(p.dims), offset: 0 })

// Element-by-element remainder, with the sign of the DIVIDEND, on the
// same zero-divisor terms as `div`.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([7, 8], [2])
//         Ok(a)  =>
//             match ndint.rem(a, ndint.scalar(3))
//                 Ok(b)  => println("${ndint.to_list(b)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn rem(left: NdInt, right: NdInt) -> Result<NdInt, NdFault>
    match ni_pair(left, right)
        Err(e) => Err(e)
        Ok(p)  =>
            var out: [Int] = []
            for i in 0..list.len(p.left)
                if p.right[i] == 0
                    return Err(NdBadRange("an integer remainder by zero"))
                out = list.push(out, p.left[i] % p.right[i])
            Ok(NdInt { data: out, shape: ndshape.of_dims(p.dims), offset: 0 })

// Every element negated.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.ones([3])
//         Ok(a)  => println("${ndint.sum(ndint.neg(a))}")
//         Err(e) => println(e.message())
// ```
pub fn neg(a: NdInt) -> NdInt
    map(a, ni_negated)

// Every element's magnitude.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([-1, 2], [2])
//         Ok(a)  => println("${ndint.sum(ndint.abs(a))}")
//         Err(e) => println(e.message())
// ```
pub fn abs(a: NdInt) -> NdInt
    map(a, ni_magnitude)

// Every element through a function of the caller's.
//
// ```novo
// use ndint
//
// fn double(x: Int) -> Int
//     x * 2
//
// fn main() [io]
//     match ndint.ones([4])
//         Ok(a)  => println("${ndint.sum(ndint.map(a, double))}")
//         Err(e) => println(e.message())
// ```
pub fn map(a: NdInt, f: fn(Int) -> Int) -> NdInt
    let out: [Int] = list.map(ni_read(a), v => f(v))
    NdInt { data: out, shape: ndshape.of_dims(a.shape.dims), offset: 0 }

// Where two arrays are equal, broadcasting by `ndshape.broadcast`.
//
// Exact, and with no NaN to worry about — which is one more reason a
// label or a key belongs in an `NdInt` rather than an `NdFloat`.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.ones([3])
//         Ok(a)  =>
//             match ndint.eq(a, a)
//                 Ok(m)  => println("${ndbool.count(m)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn eq(left: NdInt, right: NdInt) -> Result<NdMask, NdFault>
    ni_compare(left, right, ni_is_eq)

// Where two arrays differ, broadcasting by `ndshape.broadcast`.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.ones([3])
//         Ok(a)  =>
//             match ndint.ne(a, ndint.scalar(0))
//                 Ok(m)  => println("${ndbool.count(m)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn ne(left: NdInt, right: NdInt) -> Result<NdMask, NdFault>
    ni_compare(left, right, ni_is_ne)

// Where `left` is below `right`, broadcasting by `ndshape.broadcast`.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 5], [2])
//         Ok(a)  =>
//             match ndint.lt(a, ndint.scalar(3))
//                 Ok(m)  => println("${ndbool.count(m)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn lt(left: NdInt, right: NdInt) -> Result<NdMask, NdFault>
    ni_compare(left, right, ni_is_lt)

// Where `left` is at most `right`, broadcasting by
// `ndshape.broadcast`.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 5], [2])
//         Ok(a)  =>
//             match ndint.le(a, ndint.scalar(1))
//                 Ok(m)  => println("${ndbool.count(m)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn le(left: NdInt, right: NdInt) -> Result<NdMask, NdFault>
    ni_compare(left, right, ni_is_le)

// Where `left` is above `right`, broadcasting by `ndshape.broadcast`.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([-1, 5], [2])
//         Ok(a)  =>
//             match ndint.gt(a, ndint.scalar(0))
//                 Ok(m)  => println("${ndbool.count(m)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn gt(left: NdInt, right: NdInt) -> Result<NdMask, NdFault>
    ni_compare(left, right, ni_is_gt)

// Where `left` is at least `right`, broadcasting by
// `ndshape.broadcast`.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([-1, 5], [2])
//         Ok(a)  =>
//             match ndint.ge(a, ndint.scalar(5))
//                 Ok(m)  => println("${ndbool.count(m)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn ge(left: NdInt, right: NdInt) -> Result<NdMask, NdFault>
    ni_compare(left, right, ni_is_ge)

// The elements the mask picks, as a rank-1 array in row-major order.
//
// The mask must have the array's shape exactly; see
// `ndfloat.select` for why a selection does not broadcast.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([-1, 5], [2])
//         Ok(a)  =>
//             match ndint.gt(a, ndint.scalar(0))
//                 Ok(m)  =>
//                     match ndint.select(a, m)
//                         Ok(p)  => println("${ndint.to_list(p)}")
//                         Err(e) => println(e.message())
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn select(a: NdInt, keep: NdMask) -> Result<NdInt, NdFault>
    let picked = ndbool.shape(keep)
    if a.shape.dims != picked.dims
        return Err(NdShapeMismatch(a.shape.dims, picked.dims))
    let vals = ni_read(a)
    let flags = ndbool.to_list(keep)
    var out: [Int] = []
    for i in 0..list.len(vals)
        if flags[i]
            out = list.push(out, vals[i])
    Ok(NdInt { data: out, shape: ndshape.of_dims([list.len(out)]), offset: 0 })

// The elements at these positions along one axis, in the order given.
//
// The gather a group-by and a join are built out of: `take(rows, 0,
// order)` reorders an array's rows without sorting anything itself.
// Positions may repeat and may be in any order; each one must be
// inside the axis, or `NdIndexOutOfRange`.  The result is packed,
// because a gather is not expressible as strides.
//
// It is here rather than in `ndfloat` as well because the positions
// themselves are integers, and this is the module that owns them —
// `ndfloat.take_rows` would be the mirror, and the day the two arrays
// are one type it is one function.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([10, 20, 30], [3])
//         Ok(a)  =>
//             match ndint.take(a, 0, [2, 0, 2])
//                 Ok(t)  => println("${ndint.to_list(t)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn take(a: NdInt, axis: Int, positions: [Int]) -> Result<NdInt, NdFault>
    let r = list.len(a.shape.dims)
    if axis < 0 or axis >= r
        return Err(NdAxisOutOfRange(axis, r))
    for p in positions
        if p < 0 or p >= a.shape.dims[axis]
            return Err(NdIndexOutOfRange(positions, a.shape.dims))
    // A gather is not expressible as strides, so the walk substitutes the
    // caller's positions for the gathered axis and materialises.
    var acc: [Int] = [a.offset]
    for ax in 0..r
        let step = a.shape.strides[ax]
        if ax == axis
            acc = list.flat_map(acc, base => list.map(positions, p => base + p * step))
        else
            let extent = a.shape.dims[ax]
            acc = list.flat_map(acc, base => list.map(list.range(0, extent), k => base + k * step))
    var dims: [Int] = []
    for i in 0..r
        if i == axis
            dims = list.push(dims, list.len(positions))
        else
            dims = list.push(dims, a.shape.dims[i])
    let out: [Int] = list.map(acc, o => a.data[o])
    Ok(NdInt { data: out, shape: ndshape.of_dims(dims), offset: 0 })

// Every element added up.  The sum of nothing is 0.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2, 3], [3])
//         Ok(a)  => println("${ndint.sum(a)}")
//         Err(e) => println(e.message())
// ```
pub fn sum(a: NdInt) -> Int
    var total = 0
    for v in ni_read(a)
        total = total + v
    total

// The smallest element.  `NdEmptyReduction` on an empty array.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([3, 1], [2])
//         Ok(a)  =>
//             match ndint.min(a)
//                 Ok(v)  => println("${v}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn min(a: NdInt) -> Result<Int, NdFault>
    let vals = ni_read(a)
    if list.len(vals) == 0
        return Err(NdEmptyReduction("min"))
    Ok(vals[ni_extreme(vals, true)])

// The largest element.  `NdEmptyReduction` on an empty array.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([3, 1], [2])
//         Ok(a)  =>
//             match ndint.max(a)
//                 Ok(v)  => println("${v}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn max(a: NdInt) -> Result<Int, NdFault>
    let vals = ni_read(a)
    if list.len(vals) == 0
        return Err(NdEmptyReduction("max"))
    Ok(vals[ni_extreme(vals, false)])

// The full index of the smallest element; the FIRST one on a tie.
// `NdEmptyReduction` on an empty array.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([3, 1, 2], [3])
//         Ok(a)  =>
//             match ndint.argmin(a)
//                 Ok(i)  => println("${i}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn argmin(a: NdInt) -> Result<[Int], NdFault>
    let vals = ni_read(a)
    if list.len(vals) == 0
        return Err(NdEmptyReduction("argmin"))
    Ok(ni_unravel(a.shape.dims, ni_extreme(vals, true)))

// The full index of the largest element; the FIRST one on a tie.
// `NdEmptyReduction` on an empty array.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([3, 1, 2], [3])
//         Ok(a)  =>
//             match ndint.argmax(a)
//                 Ok(i)  => println("${i}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn argmax(a: NdInt) -> Result<[Int], NdFault>
    let vals = ni_read(a)
    if list.len(vals) == 0
        return Err(NdEmptyReduction("argmax"))
    Ok(ni_unravel(a.shape.dims, ni_extreme(vals, false)))

// Sums along one axis, which is dropped.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2, 3, 4], [2, 2])
//         Ok(a)  =>
//             match ndint.sum_axis(a, 0)
//                 Ok(s)  => println("${ndint.to_list(s)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn sum_axis(a: NdInt, axis: Int) -> Result<NdInt, NdFault>
    match ndshape.drop_axis(a.shape, axis)
        Err(e)   => Err(e)
        Ok(rest) =>
            var out: [Int] = []
            for lane in ni_lanes(a, axis)
                var total = 0
                for v in lane
                    total = total + v
                out = list.push(out, total)
            Ok(NdInt { data: out, shape: ndshape.of_dims(rest.dims), offset: 0 })

// Smallest elements along one axis, which is dropped.
// `NdEmptyReduction` when that axis has extent 0.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2, 3, 4], [2, 2])
//         Ok(a)  =>
//             match ndint.min_axis(a, 0)
//                 Ok(s)  => println("${ndint.to_list(s)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn min_axis(a: NdInt, axis: Int) -> Result<NdInt, NdFault>
    match ndshape.drop_axis(a.shape, axis)
        Err(e)   => Err(e)
        Ok(rest) =>
            if a.shape.dims[axis] == 0
                return Err(NdEmptyReduction("min_axis"))
            let out: [Int] = list.map(ni_lanes(a, axis), lane => lane[ni_extreme(lane, true)])
            Ok(NdInt { data: out, shape: ndshape.of_dims(rest.dims), offset: 0 })

// Largest elements along one axis, which is dropped.
// `NdEmptyReduction` when that axis has extent 0.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2, 3, 4], [2, 2])
//         Ok(a)  =>
//             match ndint.max_axis(a, 0)
//                 Ok(s)  => println("${ndint.to_list(s)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn max_axis(a: NdInt, axis: Int) -> Result<NdInt, NdFault>
    match ndshape.drop_axis(a.shape, axis)
        Err(e)   => Err(e)
        Ok(rest) =>
            if a.shape.dims[axis] == 0
                return Err(NdEmptyReduction("max_axis"))
            let out: [Int] = list.map(ni_lanes(a, axis), lane => lane[ni_extreme(lane, false)])
            Ok(NdInt { data: out, shape: ndshape.of_dims(rest.dims), offset: 0 })

// The inner product of two rank-1 arrays.  `NdNotMatrix` at any other
// rank.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2, 3], [3])
//         Ok(a)  =>
//             match ndint.dot(a, a)
//                 Ok(v)  => println("${v}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn dot(left: NdInt, right: NdInt) -> Result<Int, NdFault>
    let lr = list.len(left.shape.dims)
    if lr != 1
        return Err(NdNotMatrix("dot", lr))
    let rr = list.len(right.shape.dims)
    if rr != 1
        return Err(NdNotMatrix("dot", rr))
    if left.shape.dims[0] != right.shape.dims[0]
        return Err(NdShapeMismatch(left.shape.dims, right.shape.dims))
    let l = ni_read(left)
    let r = ni_read(right)
    var total = 0
    for i in 0..list.len(l)
        total = total + l[i] * r[i]
    Ok(total)

// The matrix product, on `ndfloat.matmul`'s rank rules.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 0, 0, 1], [2, 2])
//         Ok(i)  =>
//             match ndint.matmul(i, i)
//                 Ok(p)  => println("${ndint.sum(p)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn matmul(left: NdInt, right: NdInt) -> Result<NdInt, NdFault>
    let lr = list.len(left.shape.dims)
    if lr < 1 or lr > 2
        return Err(NdNotMatrix("matmul", lr))
    let rr = list.len(right.shape.dims)
    if rr < 1 or rr > 2
        return Err(NdNotMatrix("matmul", rr))
    // numpy's promotion: a rank-1 LEFT operand is one ROW, a rank-1 RIGHT
    // operand is one COLUMN, and the promoted axis is dropped again from
    // the answer.
    var rows = 1
    var inner = left.shape.dims[0]
    if lr == 2
        rows = left.shape.dims[0]
        inner = left.shape.dims[1]
    var cols = 1
    if rr == 2
        cols = right.shape.dims[1]
    if inner != right.shape.dims[0]
        return Err(NdShapeMismatch(left.shape.dims, right.shape.dims))
    let l = ni_read(left)
    let r = ni_read(right)
    var out: [Int] = []
    for i in 0..rows
        for j in 0..cols
            var total = 0
            for p in 0..inner
                total = total + l[i * inner + p] * r[p * cols + j]
            out = list.push(out, total)
    var dims: [Int] = [rows, cols]
    if lr == 1 and rr == 1
        dims = []
    elif lr == 1
        dims = [cols]
    elif rr == 1
        dims = [rows]
    Ok(NdInt { data: out, shape: ndshape.of_dims(dims), offset: 0 })

// Every element widened to a Float.
//
// Exact below 2^53 and rounded above it, which is the language's own
// conversion and is why `mean` lives on the other side of this call
// rather than on this one.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2, 3], [3])
//         Ok(a)  => println("${ndfloat.sum(ndint.to_float(a))}")
//         Err(e) => println(e.message())
// ```
pub fn to_float(a: NdInt) -> NdFloat
    let out: [Float] = list.map(ni_read(a), v => int.to_float(v))
    NdFloat { data: out, shape: ndshape.of_dims(a.shape.dims), offset: 0 }

// ── The module's own machinery ─────────────────────────────────────
//
// Everything below is private, and it MIRRORS `ndfloat`'s machinery
// function for function — the same reason the public surface does.
// The walk, the stretch and the pairing live once per module rather
// than published from `ndshape`, because a `pub fn` added to a package
// eight others depend on is a wider change than thirty duplicated
// lines, and the day `NdArray<T>` is spellable the copies become one.

// Every flat position this shape addresses, in row-major order, with
// one axis left unexpanded.  `skip` of -1 expands every axis.
fn ni_walk(s: NdShape, offset: Int, skip: Int) -> [Int]
    var acc: [Int] = [offset]
    for ax in 0..list.len(s.dims)
        if ax != skip
            // Expanding one axis multiplies the positions gathered so
            // far by that axis's extent, which is what `flat_map` is.
            let extent = s.dims[ax]
            let step = s.strides[ax]
            acc = list.flat_map(acc, base => list.map(list.range(0, extent), k => base + k * step))
    acc

// Every element in row-major order, view or not.
fn ni_read(a: NdInt) -> [Int]
    // A PACKED array's buffer, read in order from its offset, already
    // IS its elements in row-major order — `ndshape.is_packed` says so
    // — so the common case hands the buffer back and walks nothing.
    if a.offset == 0 and ndshape.is_packed(a.shape) and list.len(a.data) == ndshape.size(a.shape)
        return a.data
    list.map(ni_walk(a.shape, a.offset, -1), o => a.data[o])

// One lane per element of the reduced array: the elements a reduction
// along `axis` folds, in the result's row-major order.
fn ni_lanes(a: NdInt, axis: Int) -> [[Int]]
    let extent = a.shape.dims[axis]
    let step = a.shape.strides[axis]
    list.map(ni_walk(a.shape, a.offset, axis),
        base => list.map(list.range(0, extent), k => a.data[base + k * step]))

// The strides that stretch `s` to `dims`, or why they do not.  A
// stretched axis is a stride of 0; the rule is `ndshape.broadcast`'s.
fn ni_stretch(s: NdShape, dims: [Int]) -> Result<NdShape, NdFault>
    let r = list.len(s.dims)
    let n = list.len(dims)
    if n < r
        return Err(NdNotBroadcastable(s.dims, dims))
    var strides: [Int] = []
    for i in 0..n
        let si = i - (n - r)
        var d = 1
        var st = 0
        if si >= 0
            d = s.dims[si]
            st = s.strides[si]
        if d == dims[i]
            strides = list.push(strides, st)
        elif d == 1
            strides = list.push(strides, 0)
        else
            return Err(NdNotBroadcastable(s.dims, dims))
    Ok(NdShape { dims: dims, strides: strides })

// The strides that read `s` over `dims`, where `dims` is ALREADY a
// shape `s` broadcasts to.
//
// This is the stretch with no refusal in it, and it exists so the
// binary operations have no unreachable error arm: by the time one of
// them gets here `ndshape.broadcast` has agreed the shape, so an axis
// either matches — and keeps its stride — or is stretched, which is a
// stride of 0.  `ni_stretch` above is the fallible entry, and it
// is what the PUBLIC `broadcast_to` calls, because there the caller's
// `dims` is the caller's own and may be anything.
fn ni_widen(s: NdShape, dims: [Int]) -> NdShape
    let r = list.len(s.dims)
    let n = list.len(dims)
    var strides: [Int] = []
    for i in 0..n
        let si = i - (n - r)
        if si >= 0 and s.dims[si] == dims[i]
            strides = list.push(strides, s.strides[si])
        else
            strides = list.push(strides, 0)
    NdShape { dims: dims, strides: strides }

// One operand stretched to a shape it is already known to reach, and
// read out flat.
fn ni_spread(a: NdInt, dims: [Int]) -> [Int]
    ni_read(NdInt { data: a.data, shape: ni_widen(a.shape, dims), offset: a.offset })

// Two arrays read out over the shape they broadcast to.
struct NiPair
    left: [Int]
    right: [Int]
    dims: [Int]

// Both operands stretched to their common shape and read out flat, so
// every binary operation is a walk down two equal-length lists.
fn ni_pair(left: NdInt, right: NdInt) -> Result<NiPair, NdFault>
    match ndshape.broadcast(left.shape, right.shape)
        Err(e) => Err(e)
        Ok(bs) => Ok(NiPair { left: ni_spread(left, bs.dims), right: ni_spread(right, bs.dims), dims: bs.dims })

// The broadcast binary operation, once, for the three that cannot
// fail element by element.  `div` and `rem` write their own loop,
// because a zero divisor stops the call rather than the element.
fn ni_zip(left: NdInt, right: NdInt, f: fn(Int, Int) -> Int) -> Result<NdInt, NdFault>
    match ni_pair(left, right)
        Err(e) => Err(e)
        Ok(p)  =>
            let out: [Int] = list.map(list.range(0, list.len(p.left)), i => f(p.left[i], p.right[i]))
            Ok(NdInt { data: out, shape: ndshape.of_dims(p.dims), offset: 0 })

// The broadcast comparison, once, for all six of them.
fn ni_compare(left: NdInt, right: NdInt, f: fn(Int, Int) -> Bool) -> Result<NdMask, NdFault>
    match ni_pair(left, right)
        Err(e) => Err(e)
        Ok(p)  =>
            let out: [Bool] = list.map(list.range(0, list.len(p.left)), i => f(p.left[i], p.right[i]))
            Ok(NdMask { data: out, shape: ndshape.of_dims(p.dims), offset: 0 })

// The position of the smallest (or largest) element, FIRST on a tie.
// There is no NaN among the integers, so this is the plain scan that
// `ndfloat`'s counterpart would be without one.
fn ni_extreme(vals: [Int], smallest: Bool) -> Int
    var at = 0
    var best = vals[0]
    for i in 1..list.len(vals)
        var better = vals[i] > best
        if smallest
            better = vals[i] < best
        if better
            best = vals[i]
            at = i
    at

// The full index of a row-major position.  Only ever called on a
// NON-EMPTY array, so no stride here is 0.
fn ni_unravel(dims: [Int], flat: Int) -> [Int]
    let s = ndshape.of_dims(dims)
    var out: [Int] = []
    var rest = flat
    for i in 0..list.len(dims)
        out = list.push(out, rest / s.strides[i])
        rest = rest % s.strides[i]
    out

// The operations as values `ni_zip`, `ni_compare` and `map` take.
fn ni_plus(x: Int, y: Int) -> Int
    x + y

fn ni_minus(x: Int, y: Int) -> Int
    x - y

fn ni_times(x: Int, y: Int) -> Int
    x * y

fn ni_negated(x: Int) -> Int
    0 - x

fn ni_magnitude(x: Int) -> Int
    math.abs_int(x)

fn ni_is_eq(x: Int, y: Int) -> Bool
    x == y

fn ni_is_ne(x: Int, y: Int) -> Bool
    x != y

fn ni_is_lt(x: Int, y: Int) -> Bool
    x < y

fn ni_is_le(x: Int, y: Int) -> Bool
    x <= y

fn ni_is_gt(x: Int, y: Int) -> Bool
    x > y

fn ni_is_ge(x: Int, y: Int) -> Bool
    x >= y
