    todo("ndarray-nv.ndint.filled")

// The rank-1 array `start, start+step, …`, stopping BEFORE `stop`.
//
// Half-open, and `NdBadRange` for a zero step or one that points away
// from `stop` — the same rule as `ndfloat.arange`, which is where it
// is argued.  This is the one a loop over row numbers wants.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.arange(0, 5, 1)
//         Ok(a)  => println("${ndint.to_list(a)}")
//         Err(e) => println(e.message())
// ```
pub fn arange(start: Int, stop: Int, step: Int) -> Result<NdInt, NdFault>
    todo("ndarray-nv.ndint.arange")

