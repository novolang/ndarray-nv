// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2, 3], [3])
//         Ok(a)  =>
//             match ndint.mul(a, a)
//                 Ok(b)  => println("${ndint.to_list(b)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
