    todo("ndarray-nv.ndint.mul")

// Element-by-element quotient, TRUNCATED towards zero, broadcasting by
// `ndshape.broadcast`.
//
// `NdBadRange` when any divisor is 0, which is the opposite of
// `ndfloat.div`'s call and for the opposite reason: integer division
// has no infinity to return, so there is no value that would let the
// run finish honestly.  Truncation rather than flooring means
// `div(scalar(-7), scalar(2))` is -3, matching the language's own `/`.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([4, 9], [2])
//         Ok(a)  =>
//             match ndint.div(a, ndint.scalar(2))
//                 Ok(b)  => println("${ndint.to_list(b)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn div(left: NdInt, right: NdInt) -> Result<NdInt, NdFault>
    todo("ndarray-nv.ndint.div")

// Element-by-element remainder, with the sign of the DIVIDEND, on the
// same zero-divisor terms as `div`.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([7, 8], [2])
//         Ok(a)  =>
//             match ndint.rem(a, ndint.scalar(3))
//                 Ok(b)  => println("${ndint.to_list(b)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn rem(left: NdInt, right: NdInt) -> Result<NdInt, NdFault>
    todo("ndarray-nv.ndint.rem")

