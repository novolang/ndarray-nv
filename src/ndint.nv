// ndint.nv — the N-dimensional array of Int: counts, positions,
// labels and indices.
//
// WHY THIS IS A SEPARATE TYPE AND NOT `NdFloat` WITH A DTYPE TAG.  Two
// reasons, and the first is the one that decided it.  A dtype tag
// makes every function in the package branch on it, which turns one
// `sum` into a `sum` with two bodies and a third case for the
// combination nobody meant; and an Int that has been through a double
// is not the Int that went in above 2^53, which is exactly the range a
// row count reaches in the data a notebook loads.  Positions and
// counts are integers, and they stay integers here.
//
// WHY IT IS NOT ONE GENERIC `NdArray<T>` INSTEAD.  Because a generic
// container cannot be called across a module boundary today.  The
// measurement is in `ndfloat`'s module comment and the argument is in
// the README; the surface below deliberately MIRRORS `ndfloat`'s,
// member for member and name for name, so that the day the compiler
// can carry a type parameter out of a module the two collapse into one
// by deletion.
//
// WHAT IS DELIBERATELY MISSING, AND WHERE IT WENT.  There is no
// `mean`, no `sqrt`, no `exp`, no `ln` and no `linspace` here: every
// one of them answers with a number that is not an integer, and
// rounding it silently is worse than making the caller write
// `to_float` and mean it.  `ndint.to_float` is that call.
//
// EVERYTHING ELSE IS `ndfloat`'S STORY.  Views, broadcasting, the
// absence of an in-place write, the absence of an `add_scalar`: all
// four hold here for the same reasons and are argued there and in
// `ndshape`.

// An N-dimensional array of Int over a flat buffer.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2, 3, 4], [2, 2])
//         Ok(a)  => println("${ndint.sum(a)}")
//         Err(e) => println(e.message())
// ```
pub struct NdInt
    // The flat buffer.  Its length is not the array's size: a view
    // addresses a window inside it, and a broadcast axis reads one
    // element many times.
    data: [Int]
    // The extents and the strides — see `ndshape`.
    shape: NdShape
    // The flat position of element `[0, 0, …]`.
    offset: Int

// An array over these integers, in this shape, row-major.
//
// `NdSizeMismatch` when the product of `dims` is not the length of
// `data`, and `NdBadRange` for a negative dimension.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([1, 2, 3], [3])
//         Ok(a)  => println("${ndint.to_list(a)}")
//         Err(e) => println(e.message())
// ```
pub fn of_list(data: [Int], dims: [Int]) -> Result<NdInt, NdFault>
    todo("ndarray-nv.ndint.of_list")

// The rank-0 array holding one integer, which broadcasts against every
// shape.
//
// ```novo
// use ndint
//
// fn main() [io]
//     println("${ndint.sum(ndint.scalar(3))}")
// ```
pub fn scalar(value: Int) -> NdInt
    todo("ndarray-nv.ndint.scalar")

// An array of this shape, every element 0.
