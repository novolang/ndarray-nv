// fn main() [io]
//     match ndint.ones([4])
//         Ok(a)  => println("${ndint.sum(ndint.map(a, double))}")
//         Err(e) => println(e.message())
// ```
pub fn map(a: NdInt, f: fn(Int) -> Int) -> NdInt
    todo("ndarray-nv.ndint.map")

// Where two arrays are equal, broadcasting by `ndshape.broadcast`.
//
// Exact, and with no NaN to worry about — which is one more reason a
// label or a key belongs in an `NdInt` rather than an `NdFloat`.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.ones([3])
//         Ok(a)  =>
//             match ndint.eq(a, a)
//                 Ok(m)  => println("${ndbool.count(m)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn eq(left: NdInt, right: NdInt) -> Result<NdMask, NdFault>
    todo("ndarray-nv.ndint.eq")

// Where two arrays differ, broadcasting by `ndshape.broadcast`.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.ones([3])
//         Ok(a)  =>
//             match ndint.ne(a, ndint.scalar(0))
//                 Ok(m)  => println("${ndbool.count(m)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn ne(left: NdInt, right: NdInt) -> Result<NdMask, NdFault>
    todo("ndarray-nv.ndint.ne")

