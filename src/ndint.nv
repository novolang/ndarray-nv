// The elements the mask picks, as a rank-1 array in row-major order.
//
// The mask must have the array's shape exactly; see
// `ndfloat.select` for why a selection does not broadcast.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([-1, 5], [2])
//         Ok(a)  =>
//             match ndint.gt(a, ndint.scalar(0))
//                 Ok(m)  =>
//                     match ndint.select(a, m)
//                         Ok(p)  => println("${ndint.to_list(p)}")
//                         Err(e) => println(e.message())
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn select(a: NdInt, keep: NdMask) -> Result<NdInt, NdFault>
    todo("ndarray-nv.ndint.select")

// The elements at these positions along one axis, in the order given.
//
// The gather a group-by and a join are built out of: `take(rows, 0,
// order)` reorders an array's rows without sorting anything itself.
// Positions may repeat and may be in any order; each one must be
// inside the axis, or `NdIndexOutOfRange`.  The result is packed,
// because a gather is not expressible as strides.
//
// It is here rather than in `ndfloat` as well because the positions
// themselves are integers, and this is the module that owns them —
// `ndfloat.take_rows` would be the mirror, and the day the two arrays
// are one type it is one function.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([10, 20, 30], [3])
//         Ok(a)  =>
//             match ndint.take(a, 0, [2, 0, 2])
//                 Ok(t)  => println("${ndint.to_list(t)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn take(a: NdInt, axis: Int, positions: [Int]) -> Result<NdInt, NdFault>
    todo("ndarray-nv.ndint.take")

