// The full index of the largest element; the FIRST one on a tie.
// `NdEmptyReduction` on an empty array.
//
// ```novo
// use ndint
//
// fn main() [io]
//     match ndint.of_list([3, 1, 2], [3])
//         Ok(a)  =>
