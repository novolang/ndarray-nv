// ndbool.nv — the array a comparison produces, and the four things
// worth asking it.
//
// A comparison does not answer a `[Bool]`.  `a > 0` on a 3-by-4 matrix
// is a 3-by-4 answer, and flattening it to twelve truths throws away
// the only thing that makes the next call expressible, whether that
// call is a selection, a count along an axis or a `where`.  A mask
// carries a shape like every other array here, and it is a view over
// its buffer on the same terms.  `ndbool.swap_axes` of a mask is free.
//
// A mask is a separate type rather than an `NdInt` of 0s and 1s,
// because the type is the documentation.  A function that takes an
// `NdMask` cannot be handed a column of counts by accident, and
// `select` and `where` in `ndfloat` say what they need in their
// signatures rather than in their prose.  The cost is `to_int` and
// `of_int` below, which are the only place the two representations
// meet.
//
// The rest of a mask's life happens elsewhere.  The comparisons that
// produce a mask are in `ndfloat` and `ndint`, beside the arrays they
// compare, and `select` and `where`, which consume one, are there too.
// What is here is everything a mask can answer on its own.
// `count_axis`, `to_int` and `of_int` name `NdInt`, so this module and
// `ndint` refer to each other.  The compiler resolves a module pair
// that way without ceremony, which is why a mask does not have to be
// an `NdInt` of 0s and 1s to avoid a cycle.

// A shaped array of truths, as a comparison leaves it.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.of_list([true, false, true, true], [2, 2])
//         Ok(m)  => println("${ndbool.count(m)} of ${ndbool.size(m)}")
//         Err(e) => println(e.message())
// ```
pub struct NdMask
    // The flat buffer.  Its length is not the array's size.  A view
    // addresses a window inside it, and a broadcast axis reads one
    // element many times.
    data: [Bool]
    // Where in `data` this array's element `[0, 0, …]` sits, and how
    // to step from there.
    shape: NdShape
    // The flat position of the first element.
    offset: Int

// A mask over these truths, in this shape, row-major.
//
// `NdSizeMismatch` when the product of `dims` is not the length of
// `data`, and `NdBadRange` for a negative dimension.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.of_list([true, false], [2])
//         Ok(m)  => println("${ndbool.size(m)}")
//         Err(e) => println(e.message())
// ```
pub fn of_list(data: [Bool], dims: [Int]) -> Result<NdMask, NdFault>
    for d in dims
        if d < 0
            return Err(NdBadRange("a shape with a negative dimension"))
    let s = ndshape.of_dims(dims)
    let want = ndshape.size(s)
    if want != list.len(data)
        return Err(NdSizeMismatch(want, list.len(data)))
    Ok(NdMask { data: data, shape: s, offset: 0 })

// A mask of this shape with every position set the same way.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.filled([2, 3], true)
//         Ok(m)  => println("${ndbool.count(m)}")
//         Err(e) => println(e.message())
// ```
pub fn filled(dims: [Int], value: Bool) -> Result<NdMask, NdFault>
    for d in dims
        if d < 0
            return Err(NdBadRange("a shape with a negative dimension"))
    let s = ndshape.of_dims(dims)
    let out: [Bool] = list.map(0..ndshape.size(s), i => value)
    Ok(NdMask { data: out, shape: s, offset: 0 })

// This mask's layout.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.filled([2, 3], true)
//         Ok(m)  => println("${ndbool.shape(m).dims}")
//         Err(e) => println(e.message())
// ```
pub fn shape(m: NdMask) -> NdShape
    m.shape

// How many positions this mask has, true and false together.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.filled([2, 3], false)
//         Ok(m)  => println("${ndbool.size(m)}")
//         Err(e) => println(e.message())
// ```
pub fn size(m: NdMask) -> Int
    ndshape.size(m.shape)

// The truth at one full index.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.of_list([true, false], [2])
//         Ok(m)  =>
//             match ndbool.at(m, [1])
//                 Ok(v)  => println("${v}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn at(m: NdMask, index: [Int]) -> Result<Bool, NdFault>
    match ndshape.flat_index(m.shape, index)
        Err(e) => Err(e)
        Ok(f)  => Ok(m.data[m.offset + f])

// Every truth in row-major order, view or not.
//
// This is the function that walks the strides, so it is correct for a
// transposed or broadcast mask and costs one element's work per
// element.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.filled([3], true)
//         Ok(m)  => println("${ndbool.to_list(m)}")
//         Err(e) => println(e.message())
// ```
pub fn to_list(m: NdMask) -> [Bool]
    nb_read(m)

// Whether every position is true.
//
// An empty mask is `true`, which is the empty conjunction.  That is
// numpy's answer, and it keeps `all(a) and all(b)` equal to
// `all(concat(a, b))`.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.of_list([true, true], [2])
//         Ok(m)  => println("${ndbool.all(m)}")
//         Err(e) => println(e.message())
// ```
pub fn all(m: NdMask) -> Bool
    for v in nb_read(m)
        if not v
            return false
    true

// Whether any position is true.
//
// An empty mask is `false`, for the mirror of the reason above.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.of_list([false, true], [2])
//         Ok(m)  => println("${ndbool.any(m)}")
//         Err(e) => println(e.message())
// ```
pub fn any(m: NdMask) -> Bool
    for v in nb_read(m)
        if v
            return true
    false

// How many positions are true.
//
// This is the question asked most often, because `count(a > 0)` is how
// many rows survived.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.of_list([true, false, true], [3])
//         Ok(m)  => println("${ndbool.count(m)}")
//         Err(e) => println(e.message())
// ```
pub fn count(m: NdMask) -> Int
    var n = 0
    for v in nb_read(m)
        if v
            n = n + 1
    n

// How many positions are true along one axis, as an `NdInt` of one
// lower rank.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.filled([2, 3], true)
//         Ok(m)  =>
//             match ndbool.count_axis(m, 1)
//                 Ok(c)  => println("${ndint.to_list(c)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn count_axis(m: NdMask, axis: Int) -> Result<NdInt, NdFault>
    match ndshape.drop_axis(m.shape, axis)
        Err(e)   => Err(e)
        Ok(rest) =>
            let extent = m.shape.dims[axis]
            let step = m.shape.strides[axis]
            var out: [Int] = []
            for base in nb_walk(m.shape, m.offset, axis)
                var c = 0
                for k in 0..extent
                    if m.data[base + k * step]
                        c = c + 1
                out = list.push(out, c)
            Ok(NdInt { data: out, shape: ndshape.of_dims(rest.dims), offset: 0 })

// Position-by-position conjunction, broadcasting.  Named `both`
// because `and` is a reserved word (SPEC § 1.3).
//
// The rule is `ndshape.broadcast`.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.of_list([true, false], [2])
//         Ok(m)  =>
//             match ndbool.both(m, m)
//                 Ok(r)  => println("${ndbool.count(r)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn both(left: NdMask, right: NdMask) -> Result<NdMask, NdFault>
    match nb_pair(left, right)
        Err(e) => Err(e)
        Ok(p)  =>
            let out: [Bool] = list.map(0..list.len(p.left), i => p.left[i] and p.right[i])
            Ok(NdMask { data: out, shape: ndshape.of_dims(p.dims), offset: 0 })

// Position-by-position disjunction, broadcasting by
// `ndshape.broadcast`.  Named `either` because `or` is reserved.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.of_list([true, false], [2])
//         Ok(m)  =>
//             match ndbool.either(m, m)
//                 Ok(r)  => println("${ndbool.count(r)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn either(left: NdMask, right: NdMask) -> Result<NdMask, NdFault>
    match nb_pair(left, right)
        Err(e) => Err(e)
        Ok(p)  =>
            let out: [Bool] = list.map(0..list.len(p.left), i => p.left[i] or p.right[i])
            Ok(NdMask { data: out, shape: ndshape.of_dims(p.dims), offset: 0 })

// Position-by-position negation, into a fresh packed buffer.  No
// stride means "negated", so there is nothing to view.  Named `invert`
// because `not` is reserved.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.of_list([true, false], [2])
//         Ok(m)  => println("${ndbool.count(ndbool.invert(m))}")
//         Err(e) => println(e.message())
// ```
pub fn invert(m: NdMask) -> NdMask
    let out: [Bool] = list.map(nb_read(m), v => not v)
    NdMask { data: out, shape: ndshape.of_dims(m.shape.dims), offset: 0 }

// The mask with two axes exchanged.  A view, so it does not copy.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.filled([2, 3], true)
//         Ok(m)  =>
//             match ndbool.swap_axes(m, 0, 1)
//                 Ok(t)  => println("${ndbool.shape(t).dims}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn swap_axes(m: NdMask, first: Int, second: Int) -> Result<NdMask, NdFault>
    match ndshape.swap_axes(m.shape, first, second)
        Err(e) => Err(e)
        Ok(s)  => Ok(NdMask { data: m.data, shape: s, offset: m.offset })

// The same mask over a fresh, contiguous, exactly-sized buffer.
//
// The one function here whose purpose is to copy.  `ndshape`'s module
// comment says what a view keeps alive.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.filled([2, 3], true)
//         Ok(m)  => println("${ndbool.size(ndbool.pack(m))}")
//         Err(e) => println(e.message())
// ```
pub fn pack(m: NdMask) -> NdMask
    if m.offset == 0 and ndshape.is_packed(m.shape) and list.len(m.data) == ndshape.size(m.shape)
        return m
    NdMask { data: nb_read(m), shape: ndshape.of_dims(m.shape.dims), offset: 0 }

// The mask as 1s and 0s, so it can be summed, grouped or joined.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndbool.of_list([true, false, true], [3])
//         Ok(m)  => println("${ndint.to_list(ndbool.to_int(m))}")
//         Err(e) => println(e.message())
// ```
pub fn to_int(m: NdMask) -> NdInt
    var out: [Int] = []
    for v in nb_read(m)
        if v
            out = list.push(out, 1)
        else
            out = list.push(out, 0)
    NdInt { data: out, shape: ndshape.of_dims(m.shape.dims), offset: 0 }

// Non-zero is true and zero is false, which is the inverse of
// `to_int`.
//
// ```novo
// use ndbool
//
// fn main() [io]
//     match ndint.of_list([1, 0, 2], [3])
//         Ok(a)  => println("${ndbool.count(ndbool.of_int(a))}")
//         Err(e) => println(e.message())
// ```
pub fn of_int(a: NdInt) -> NdMask
    let out: [Bool] = list.map(ndint.to_list(a), v => v != 0)
    NdMask { data: out, shape: ndshape.of_dims(a.shape.dims), offset: 0 }

// ── The module's own machinery ─────────────────────────────────────
//
// Four private helpers, and they are private on purpose.  They are the
// same ones `ndfloat` and `ndint` carry, written out once per module
// rather than published from `ndshape`.  A `pub fn` added to a package
// eight others already depend on is a wider change than thirty
// duplicated lines.

// Every flat position this mask's shape addresses, in row-major order,
// skipping the expansion of one axis.
//
// `skip` of -1 expands every axis, which is the whole array.  Any
// other value leaves that axis unexpanded, so the answer is one base
// position per element of the array with that axis dropped.  That is
// what a reduction along the axis walks.
fn nb_walk(s: NdShape, offset: Int, skip: Int) -> [Int]
    var acc: [Int] = [offset]
    for ax in 0..list.len(s.dims)
        if ax != skip
            // Expanding one axis multiplies the positions gathered so
            // far by that axis's extent, which is what `flat_map` is.
            let extent = s.dims[ax]
            let step = s.strides[ax]
            acc = list.flat_map(acc, base => list.map(0..extent, k => base + k * step))
    acc

// Every truth in row-major order, view or not.
fn nb_read(m: NdMask) -> [Bool]
    // A packed array's buffer, read in order from its offset, is
    // already its elements in row-major order, as `ndshape.is_packed`
    // says.  The common case hands the buffer back and walks nothing.
    if m.offset == 0 and ndshape.is_packed(m.shape) and list.len(m.data) == ndshape.size(m.shape)
        return m.data
    list.map(nb_walk(m.shape, m.offset, -1), o => m.data[o])

// Two masks read out over the shape they broadcast to.
struct NbPair
    left: [Bool]
    right: [Bool]
    dims: [Int]

// The strides that read `s` over `dims`, where `dims` is already a
// shape `s` broadcasts to.
//
// This is the stretch with no refusal in it, and it exists so that
// `both` and `either` have no unreachable error arm.  By the time one
// of them gets here `ndshape.broadcast` has agreed the shape, so an
// axis either matches and keeps its stride, or is stretched, which is
// a stride of 0.  A mask has no public `broadcast_to`, so this module
// needs no fallible stretch beside it.  `ndfloat` and `ndint` carry
// one for the caller's own `dims`.
fn nb_widen(s: NdShape, dims: [Int]) -> NdShape
    let r = list.len(s.dims)
    let n = list.len(dims)
    var strides: [Int] = []
    for i in 0..n
        let si = i - (n - r)
        if si >= 0 and s.dims[si] == dims[i]
            strides = list.push(strides, s.strides[si])
        else
            strides = list.push(strides, 0)
    NdShape { dims: dims, strides: strides }

// Both operands stretched to their common shape and read out flat, so
// a combination is a walk down two equal-length lists.
fn nb_pair(left: NdMask, right: NdMask) -> Result<NbPair, NdFault>
    match ndshape.broadcast(left.shape, right.shape)
        Err(e) => Err(e)
        Ok(bs) =>
            let ls = nb_widen(left.shape, bs.dims)
            let rs = nb_widen(right.shape, bs.dims)
            Ok(NbPair {
                left: nb_read(NdMask { data: left.data, shape: ls, offset: left.offset }),
                right: nb_read(NdMask { data: right.data, shape: rs, offset: right.offset }),
                dims: bs.dims })
