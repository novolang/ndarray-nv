// ndshape.nv — how many elements there are, where each one lives, and
// the two rules a reader's mental model depends on.
//
// A shape is dims plus strides.  `dims` says how big the array is
// along each axis, outermost first.  `strides` says how far to step in
// the flat buffer to move one place along that axis.  The offset lives
// on the array rather than here, because two arrays can share a buffer
// at different starting points with the same dims and strides.
// Element `[i, j, k]` of an array with offset `o` is at
//
//     o + i*strides[0] + j*strides[1] + k*strides[2]
//
// and that one line is the whole layout.
//
// Row-major is the default, and it is the only order constructed.
// `of_dims` builds the strides in C order, where the last axis moves
// fastest, so a freshly built array reads the way a nested list
// literal does.  Column-major arrives only as the result of a
// transpose, never as a construction option.  A second constructor
// would double every test in the package to describe a layout that is
// one call away.
//
// A transpose does not copy, and neither does a slice, a broadcast or
// an index along an axis.  All four are views, which means a new shape
// over the same buffer.  In numpy that answer comes with a warning
// attached, because a view aliases memory somebody else can write
// through, and a reader who does not know which operations view and
// which copy gets a wrong answer.  Here it comes with no warning at
// all.  A novo-lang list is a value, and nothing in this package
// mutates an array in place, so there is no writer and no aliasing
// hazard for a view to expose.  `ndfloat.with` answers a new array
// rather than writing into the old one.  A view is free and it is
// safe, and those two facts have the same cause.
//
// What that buys is the reason to carry strides at all.  A transpose
// of a million-element matrix is a list of two integers reversed.
// What it costs is that a view's buffer stays alive as long as the
// view does, so slicing three elements out of a large array and
// keeping only the slice keeps the large array too.  `ndfloat.pack` is
// the escape.  It materialises a view into a fresh, contiguous,
// exactly-sized buffer, and it is the only function in the package
// whose purpose is to copy.
//
// The broadcasting rule is written once, in `broadcast` below, and
// every other page in the package points at it.

// The layout of an array: its extent along each axis, and the step
// through the flat buffer that moves one place along it.
//
// `dims` and `strides` are always the same length, and that length is
// the rank.  A rank-0 shape has both lists empty, and it is the
// scalar, which broadcasts against every other shape.
// `ndfloat.scalar` is how one is made, and it is why this package has
// no `add_scalar` beside `add`.
//
// ```novo
// use ndshape
//
// fn main() [io]
//     let s = ndshape.of_dims([2, 3])
//     println("rank ${ndshape.rank(s)} size ${ndshape.size(s)}")
// ```
pub struct NdShape
    // The extent along each axis, outermost first.  Every entry is
    // non-negative.  A zero entry makes the array empty but keeps its
    // rank, which is what lets an empty selection still be reshaped.
    dims: [Int]
    // The step through the flat buffer, one per axis.  A stride may be
    // zero, which is what a broadcast axis is, an axis whose every
    // position reads the same element.  `is_packed` is therefore a
    // question worth asking rather than something derived from `dims`.
    strides: [Int]

// The row-major shape of an array with these dimensions.
//
// The strides run right to left.  The last axis has stride 1, and each
// axis to its left has the stride of the one after it times that one's
// extent.  `[2, 3]` gets `[3, 1]`, and element `[1, 2]` is at flat
// position 5.
//
// ```novo
// use ndshape
//
// fn main() [io]
//     let s = ndshape.of_dims([2, 3])
//     println("${s.strides}")
// ```
pub fn of_dims(dims: [Int]) -> NdShape
    var strides: [Int] = []
    var acc = 1
    var i = list.len(dims) - 1
    while i >= 0
        strides = list.push(strides, acc)
        acc = acc * dims[i]
        i = i - 1
    NdShape { dims: dims, strides: list.reverse(strides) }

// The shape of a scalar: rank 0, one element, no axes.
//
// A scalar is not a one-element vector.  It has rank 0, so it
// broadcasts against an array of any rank, which is the reason it
// exists here.  The module comment says more.
//
// ```novo
// use ndshape
//
// fn main() [io]
//     println("${ndshape.rank(ndshape.scalar())}")
// ```
pub fn scalar() -> NdShape
    NdShape { dims: [], strides: [] }

// How many axes this shape has.
//
// ```novo
// use ndshape
//
// fn main() [io]
//     println("${ndshape.rank(ndshape.of_dims([2, 3, 4]))}")
// ```
pub fn rank(s: NdShape) -> Int
    list.len(s.dims)

// How many elements this shape describes: the product of its dims.
//
// A rank-0 shape has size 1, which is the empty product.  A shape with
// a zero anywhere in `dims` has size 0.
//
// ```novo
// use ndshape
//
// fn main() [io]
//     println("${ndshape.size(ndshape.of_dims([2, 3]))}")
// ```
pub fn size(s: NdShape) -> Int
    var n = 1
    for d in s.dims
        n = n * d
    n

// Whether this shape reads the flat buffer front to back with no gaps
// and no repeats.
//
// True exactly when the strides are the row-major strides of the dims.
// A packed array's buffer, read in order from its offset, is its
// elements in row-major order.  That is what `ndfloat.to_list` hands
// back without walking the strides.
//
// ```novo
// use ndshape
//
// fn main() [io]
//     println("${ndshape.is_packed(ndshape.of_dims([2, 3]))}")
// ```
pub fn is_packed(s: NdShape) -> Bool
    s.strides == of_dims(s.dims).strides

// The flat position of one element, relative to the array's offset.
//
// `index` must have exactly `rank(s)` coordinates, each in
// `[0, dims[axis])`.  A short index is `NdRankMismatch` and an
// out-of-range coordinate is `NdIndexOutOfRange`.  They are two
// different mistakes with two different fixes.
//
// ```novo
// use ndshape
//
// fn main() [io]
//     match ndshape.flat_index(ndshape.of_dims([2, 3]), [1, 2])
//         Ok(n)  => println("at ${n}")
//         Err(e) => println(e.message())
// ```
pub fn flat_index(s: NdShape, index: [Int]) -> Result<Int, NdFault>
    let r = list.len(s.dims)
    if list.len(index) != r
        return Err(NdRankMismatch(r, list.len(index)))
    var flat = 0
    for i in 0..r
        if index[i] < 0 or index[i] >= s.dims[i]
            return Err(NdIndexOutOfRange(index, s.dims))
        flat = flat + index[i] * s.strides[i]
    Ok(flat)

// The shape two operands broadcast to, or why they do not.
//
// This is the rule every broadcasting doc comment in the package
// points at.  Line the two dim lists up at their right ends and pad
// the shorter one on the left with 1s.  Then, axis by axis:
//
//   - equal extents agree, and the result takes that extent;
//   - an extent of 1 on either side agrees with anything, and the
//     result takes the other side's extent.  The size-1 axis is
//     stretched, which costs nothing because stretching is a stride
//     of 0;
//   - anything else is `NdNotBroadcastable`, with both shapes.
//
// `[3, 1]` and `[1, 4]` broadcast to `[3, 4]`.  `[2, 3]` and `[3]`
// broadcast to `[2, 3]`.  `[2, 3]` and `[4]` do not.  A rank-0 scalar
// pads to all-1s and therefore agrees with every shape, which is the
// mechanism behind `ndfloat.scalar`.
//
// The strides of the result are not this function's business.  Each
// operand is stretched into place by `ndfloat.broadcast_to`, which
// sets a 0 stride on every axis it stretched.
//
// ```novo
// use ndshape
//
// fn main() [io]
//     match ndshape.broadcast(ndshape.of_dims([3, 1]), ndshape.of_dims([1, 4]))
//         Ok(s)  => println("${s.dims}")
//         Err(e) => println(e.message())
// ```
pub fn broadcast(left: NdShape, right: NdShape) -> Result<NdShape, NdFault>
    let lr = list.len(left.dims)
    let rr = list.len(right.dims)
    var n = lr
    if rr > n
        n = rr
    var dims: [Int] = []
    for i in 0..n
        // The two shapes are lined up at their right ends, so axis `i`
        // of the result reads axis `i - pad` of each operand and takes
        // the extent 1 where that axis is off the front.
        let li = i - (n - lr)
        let ri = i - (n - rr)
        var ld = 1
        if li >= 0
            ld = left.dims[li]
        var rd = 1
        if ri >= 0
            rd = right.dims[ri]
        if ld == rd
            dims = list.push(dims, ld)
        elif ld == 1
            dims = list.push(dims, rd)
        elif rd == 1
            dims = list.push(dims, ld)
        else
            return Err(NdNotBroadcastable(left.dims, right.dims))
    Ok(of_dims(dims))

// The shape with two axes exchanged.
//
// Only the two entries of `dims` and the two of `strides` move.  The
// buffer is untouched, which is why a transpose is free.  Either axis
// outside `[0, rank)` is `NdAxisOutOfRange`.
//
// ```novo
// use ndshape
//
// fn main() [io]
//     match ndshape.swap_axes(ndshape.of_dims([2, 3]), 0, 1)
//         Ok(s)  => println("${s.dims} ${s.strides}")
//         Err(e) => println(e.message())
// ```
pub fn swap_axes(s: NdShape, first: Int, second: Int) -> Result<NdShape, NdFault>
    let r = list.len(s.dims)
    if first < 0 or first >= r
        return Err(NdAxisOutOfRange(first, r))
    if second < 0 or second >= r
        return Err(NdAxisOutOfRange(second, r))
    var dims: [Int] = []
    var strides: [Int] = []
    for i in 0..r
        var j = i
        if i == first
            j = second
        elif i == second
            j = first
        dims = list.push(dims, s.dims[j])
        strides = list.push(strides, s.strides[j])
    Ok(NdShape { dims: dims, strides: strides })

// The shape with every axis reversed, which is the transpose of a
// matrix generalised to any rank.
//
// For rank 0 and rank 1 this is the shape unchanged.  That is numpy's
// answer, and it keeps `transpose(transpose(a))` equal to `a` at every
// rank.
//
// ```novo
// use ndshape
//
// fn main() [io]
//     println("${ndshape.reverse_axes(ndshape.of_dims([2, 3])).dims}")
// ```
pub fn reverse_axes(s: NdShape) -> NdShape
    NdShape { dims: list.reverse(s.dims), strides: list.reverse(s.strides) }

// The shape with one axis dropped, as indexing a single position along
// that axis leaves it.
//
// Rank falls by one.  This is the shape side of `ndfloat.index_axis`.
// The offset the caller must add is that position times the dropped
// axis's stride, and the array function adds it.
//
// ```novo
// use ndshape
//
// fn main() [io]
//     match ndshape.drop_axis(ndshape.of_dims([2, 3]), 0)
//         Ok(s)  => println("${s.dims}")
//         Err(e) => println(e.message())
// ```
pub fn drop_axis(s: NdShape, axis: Int) -> Result<NdShape, NdFault>
    let r = list.len(s.dims)
    if axis < 0 or axis >= r
        return Err(NdAxisOutOfRange(axis, r))
    var dims: [Int] = []
    var strides: [Int] = []
    for i in 0..r
        if i != axis
            dims = list.push(dims, s.dims[i])
            strides = list.push(strides, s.strides[i])
    Ok(NdShape { dims: dims, strides: strides })

// Whether a buffer of this many elements can hold every element this
// shape addresses, starting at `offset`.
//
// The bound is the largest flat position the shape reaches, not the
// product of its dims.  A broadcast axis has stride 0 and addresses no
// new memory, and a view addresses a window inside a larger buffer.
// Every constructor that builds an array from a caller's list checks
// this, and reports `NdSizeMismatch` when it does not hold.
//
// ```novo
// use ndshape
//
// fn main() [io]
//     println("${ndshape.fits(ndshape.of_dims([2, 3]), 0, 6)}")
// ```
pub fn fits(s: NdShape, offset: Int, buffer_len: Int) -> Bool
    if offset < 0
        return false
    // The bound is the largest flat position the shape reaches.  A zero
    // extent makes the array address nothing at all, and a zero stride
    // addresses no new memory, so neither adds to the reach.
    var reach = offset
    var empty = false
    for i in 0..list.len(s.dims)
        if s.dims[i] <= 0
            empty = true
        else
            reach = reach + (s.dims[i] - 1) * s.strides[i]
    if empty
        return offset <= buffer_len
    reach < buffer_len
