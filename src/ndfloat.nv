// Sums along one axis, which is dropped.
//
// A rank-2 array summed along axis 0 gives a rank-1 array of column
// totals.  The axis GOES rather than becoming 1: a notebook that wants
// it kept reshapes, and a notebook that wants it gone would otherwise
// reshape every time.  `NdAxisOutOfRange` for an axis this array does
// not have.
//
// ```novo
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([1.0, 2.0, 3.0, 4.0], [2, 2])
//         Ok(a)  =>
//             match ndfloat.sum_axis(a, 0)
//                 Ok(s)  => println("${ndfloat.to_list(s)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
