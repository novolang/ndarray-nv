// The smallest element.  `NdEmptyReduction` on an empty array.
//
// NaN is never the answer while a number is present, which is numpy's
// `nanmin` rather than its `min` — a notebook's minimum should not be
// destroyed by one bad row, and a caller who wants NaN to win can ask
// for it with a comparison.
//
// ```novo
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([3.0, 1.0], [2])
//         Ok(a)  =>
//             match ndfloat.min(a)
//                 Ok(v)  => println("${v}")
//                 Err(e) => println(e.message())
