// Every element added up.
//
// The sum of nothing is 0.0 and needs no error, which is why this one
// returns a bare Float where `mean` and `min` return a `Result`.
//
// ```novo
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([1.0, 2.0, 3.0], [3])
//         Ok(a)  => println("${ndfloat.sum(a)}")
