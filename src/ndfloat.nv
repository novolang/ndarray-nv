// The inner product of two rank-1 arrays.
//
// Strictly rank 1 on both sides — `NdNotMatrix` otherwise — because
// numpy's `dot` doing five different things at five different ranks is
// the source of most of the confusion about it.  The matrix cases are
// `matmul`.
//
// ```novo
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([1.0, 2.0, 3.0], [3])
//         Ok(a)  =>
//             match ndfloat.dot(a, a)
//                 Ok(v)  => println("${v}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn dot(left: NdFloat, right: NdFloat) -> Result<Float, NdFault>
    todo("ndarray-nv.ndfloat.dot")

// The matrix product.
//
// Both operands are rank 1 or rank 2.  A rank-1 LEFT operand is read
// as one row and the result loses that axis again; a rank-1 RIGHT
// operand is read as one column and the result loses that one — which
// is numpy's rule, so `matmul(m, v)` of a 3-by-3 and a 3 is a 3.
// `NdNotMatrix` above rank 2, `NdShapeMismatch` when the inner
// dimensions disagree.
//
// ```novo
// use ndfloat
//
// fn main() [io]
//     match ndfloat.eye(3)
//         Ok(i)  =>
//             match ndfloat.matmul(i, i)
//                 Ok(p)  => println("${ndfloat.sum(p)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn matmul(left: NdFloat, right: NdFloat) -> Result<NdFloat, NdFault>
    todo("ndarray-nv.ndfloat.matmul")

// Every element truncated towards zero, as an `NdInt`.
//
// Truncation and not rounding, so that `to_int(scalar(-1.7))` is -1;
// a caller who wants nearest adds 0.5 with the right sign first.
//
// ```novo
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([1.7, -1.7], [2])
//         Ok(a)  => println("${ndint.to_list(ndfloat.to_int(a))}")
//         Err(e) => println(e.message())
// ```
pub fn to_int(a: NdFloat) -> NdInt
    todo("ndarray-nv.ndfloat.to_int")
