// The elements the mask picks, as a rank-1 array in row-major order.
//
// The rank falls to 1 whatever the array's rank was, because a
// selection of scattered positions has no rectangle to keep.  The mask
// must have the array's shape exactly — broadcasting a selection would
// silently pick each element several times.
//
// ```novo
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([-1.0, 5.0], [2])
//         Ok(a)  =>
//             match ndfloat.gt(a, ndfloat.scalar(0.0))
//                 Ok(m)  =>
//                     match ndfloat.select(a, m)
//                         Ok(p)  => println("${ndfloat.to_list(p)}")
//                         Err(e) => println(e.message())
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
