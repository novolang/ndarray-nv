// ```novo
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([-1.0, 5.0], [2])
//         Ok(a)  =>
//             match ndfloat.gt(a, ndfloat.scalar(0.0))
//                 Ok(m)  =>
//                     match ndfloat.where(m, a, ndfloat.scalar(0.0))
//                         Ok(c)  => println("${ndfloat.to_list(c)}")
//                         Err(e) => println(e.message())
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
